2)Hill Climbing:

import random


distance = [
    [0, 4, 9, 6],
    [7, 0, 6, 4],
    [9, 6, 0, 3],
    [10, 4, 3, 0]
]


def get_cost(tour):
    cost = 0

    for i in range(len(tour) - 1):
        cost += distance[tour[i]][tour[i + 1]]

    cost += distance[tour[-1]][tour[0]]

    return cost


def get_neighbor(tour):
    neighbor = tour.copy()

    a, b = random.sample(range(len(tour)), 2)

    neighbor[a], neighbor[b] = neighbor[b], neighbor[a]

    return neighbor


def hill_climb():
    current = [0, 1, 2, 3]
    random.shuffle(current)

    current_cost = get_cost(current)

    print("Starting tour:", current, "Cost:", current_cost)

    for _ in range(10):
        neighbor = get_neighbor(current)
        neighbor_cost = get_cost(neighbor)

        print("Connected neighbor:", neighbor)
        print("Cost of tour:", neighbor_cost)

        if neighbor_cost < current_cost:
            current = neighbor
            current_cost = neighbor_cost

            print("Better tour found:", current)
            print("Cost:", current_cost)

    print("\nFinal tour:", current)
    print("Best cost:", current_cost)


hill_climb()


